# -----------------------------------------------------------------------------
# Public browser variables (safe to expose; prefixed with VITE_)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY

# -----------------------------------------------------------------------------
# Server-only variables (Vercel Functions / vercel dev). NEVER prefix these with
# VITE_, import them into src/, or commit real values.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Alternative Supabase server key name supported by the API helpers:
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY
APP_URL=https://YOUR-PRODUCTION-DOMAIN

# Initial admin bootstrap. Change after first login; stored as a salted hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Gmail + Google Calendar (OAuth refresh token with gmail.send and calendar.events)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN

# Optional Slack staff notifications
SLACK_BOT_TOKEN=xoxb-YOUR_SLACK_BOT_TOKEN
SLACK_CHANNEL_ID=YOUR_SLACK_CHANNEL_ID

# -----------------------------------------------------------------------------
# Optional legacy Base44 fallback (only used when Supabase is not configured).
# Do not put secrets here.
# -----------------------------------------------------------------------------
# VITE_BASE44_APP_ID=YOUR_24_HEX_BASE44_APP_ID
# VITE_BASE44_APP_BASE_URL=https://base44.app
# VITE_BASE44_FUNCTIONS_VERSION=
